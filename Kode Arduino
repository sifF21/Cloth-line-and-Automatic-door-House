
#include <Servo.h>

// =====================================================
// SERVO 1 = CLOTHES LINE / RAISE CLOTHES
// WATER SENSOR >= 300 -> 180 degrees
// =====================================================
Servo servoClothesLine;

// =====================================================
// SERVO 2 = DOOR
// HC-SR04 <= 6 cm -> 90 degrees
// After 3 seconds -> back to 0 degrees
// =====================================================
Servo servoDoor;

// ================= PINS =================
const int waterSensorPin = A0;

const int clothesLineServoPin = 9;
const int doorServoPin = 6;

const int buzzerPin = 8;
const int ledPin = 7;

// HC-SR04
const int trigPin = 10;
const int echoPin = 11;

// ================= THRESHOLDS =================
const int waterThreshold = 300;
const float distanceThreshold = 6.0;

// ================= SERVO POSITIONS =================
const int clothesLineDown = 90;
const int clothesLineUp = 180;

const int doorClosed = 0;
const int doorOpen = 90;

// ================= DOOR DELAY =================
// Door stays open for 3 seconds
const unsigned long doorOpenDuration = 3000;

unsigned long doorOpenTime = 0;
bool doorIsOpen = false;

// ================= WATER BUZZER =================
const int waterBuzzerFrequency = 220;
const unsigned long buzzerInterval = 800;

unsigned long waterBuzzerTime = 0;
bool buzzerStatus = false;

// ================= HC-SR04 STATUS =================
bool previousObjectDetection = false;


// =====================================================
// SETUP
// =====================================================
void setup() {

  Serial.begin(9600);

  servoClothesLine.attach(clothesLineServoPin);
  servoDoor.attach(doorServoPin);

  pinMode(buzzerPin, OUTPUT);
  pinMode(ledPin, OUTPUT);

  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // Initial positions
  servoClothesLine.write(clothesLineDown);
  servoDoor.write(doorClosed);

  digitalWrite(ledPin, LOW);
  noTone(buzzerPin);
}


// =====================================================
// LOOP
// =====================================================
void loop() {

  int waterValue = analogRead(waterSensorPin);
  float distance = readDistance();

  bool isRaining = (waterValue >= waterThreshold);
  bool objectNear = (distance > 0 && distance <= distanceThreshold);

  Serial.print("Water = ");
  Serial.print(waterValue);

  Serial.print(" | Distance = ");
  Serial.print(distance);

  Serial.print(" | Door = ");
  Serial.println(doorIsOpen ? "OPEN" : "CLOSED");


  // ===================================================
  // CLOTHES LINE SERVO
  // ===================================================
  if (isRaining) {

    // Raining -> raise clothes line to 180°
    servoClothesLine.write(clothesLineUp);

  } 
  else {

    // Not raining -> lower clothes line
    servoClothesLine.write(clothesLineDown);
  }


  // ===================================================
  // DOOR SERVO
  // ===================================================

  // If object detected <= 6 cm and door is not open
  if (objectNear && !doorIsOpen) {

    // Open door to 90°
    servoDoor.write(doorOpen);

    // LED on
    digitalWrite(ledPin, HIGH);

    // Door chime sound
    playDoorChime();

    // Record time when door opened
    doorOpenTime = millis();

    doorIsOpen = true;
  }


  // ===================================================
  // DOOR OPEN -> WAIT 3 SECONDS
  // ===================================================
  if (doorIsOpen) {

    if (millis() - doorOpenTime >= doorOpenDuration) {

      // Close door
      servoDoor.write(doorClosed);

      // LED off
      digitalWrite(ledPin, LOW);

      doorIsOpen = false;
    }
  }


  // ===================================================
  // WATER SENSOR BUZZER
  // Only active if door is not opening
  // ===================================================
  if (isRaining && !doorIsOpen) {

    playWaterBuzzer();

  } 
  else if (!doorIsOpen) {

    noTone(buzzerPin);
    buzzerStatus = false;
    waterBuzzerTime = millis();
  }


  // Reset object detection status
  if (!objectNear) {
    previousObjectDetection = false;
  } 
  else {
    previousObjectDetection = true;
  }

  delay(50);
}


// =====================================================
// READ HC-SR04 DISTANCE
// =====================================================
float readDistance() {

  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) {
    return 999;
  }

  float distance = duration * 0.0343 / 2.0;

  return distance;
}


// =====================================================
// WATER SENSOR BUZZER
// Low frequency intermittent buzzer
// =====================================================
void playWaterBuzzer() {

  unsigned long now = millis();

  if (now - waterBuzzerTime >= buzzerInterval) {

    waterBuzzerTime = now;

    buzzerStatus = !buzzerStatus;

    if (buzzerStatus) {

      tone(buzzerPin, waterBuzzerFrequency);  // 220 Hz

    } 
    else {

      noTone(buzzerPin);
    }
  }
}


// =====================================================
// DOOR CHIME
// Sound like a gentle two-tone doorbell
// =====================================================
void playDoorChime() {

  // First tone
  tone(buzzerPin, 784);
  delay(180);

  noTone(buzzerPin);

  delay(70);

  // Second tone
  tone(buzzerPin, 988);
  delay(300);

  noTone(buzzerPin);

  delay(100);
}

